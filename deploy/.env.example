# Copy to .env on the VPS and fill in.  ->  cp .env.example .env

# --- Public URLs (must match your DNS) ---------------------------------------
PLATFORM_BASE_URL=https://allerion.io
STORE_BASE_URL=https://skills.allerion.io
STORE_URL=https://skills.allerion.io
ACME_EMAIL=you@allerion.io

# --- Required: license signing for the store ---------------------------------
# Generate once and keep it secret/stable:  openssl rand -hex 32
STORE_SIGNING_SECRET=

# --- Stripe (leave blank to run as a preview with checkout disabled) ---------
# sk_test_... to rehearse with test cards; sk_live_... to take real money.
STRIPE_API_KEY=

# --- Optional: stable Stripe Price ids (from: python3 apps/store/setup_stripe.py)
STRIPE_PRICE_TEAM=
STRIPE_PRICE_PR_REVIEW_PRO=
STRIPE_PRICE_CHANGELOG_CRAFT=
STRIPE_PRICE_TEST_FORGE=
STRIPE_PRICE_CODEX_DEVKIT=
STRIPE_PRICE_DEVKIT_BUNDLE=
STRIPE_PRICE_ALLERION_ASSISTANT=
